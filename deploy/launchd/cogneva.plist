<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sf-network.sf-network</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/sf-network/sf-network</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Applications/sf-network</string>

    <key>StandardOutPath</key>
    <string>/Users/$USER/Library/Logs/sf-network/sf-network.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/$USER/Library/Logs/sf-network/sf-network.error.log</string>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SF_CONFIG_PATH</key>
        <string>/Users/$USER/Library/Preferences/sf-network/sf-network.json</string>
        <key>SF_DATA_DIR</key>
        <string>/Users/$USER/Library/Application Support/sf-data</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
</dict>
</plist>
