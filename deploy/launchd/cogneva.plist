<?xml version="1.0" encoding="UTF-8"?>
<!-- 仅供开发态/Lima VM 内参考：生产一键路径由 bootstrap.sh（K3s）托管，无需本单元 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cogneva.cogneva</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/cogneva/cogneva</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/cogneva</string>

    <key>StandardOutPath</key>
    <string>/var/log/cogneva/cogneva.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/cogneva/cogneva.error.log</string>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>COGNEVA_CONFIG_PATH</key>
        <string>/etc/cogneva/cogneva.json</string>
        <key>COGNEVA_WEB_DIR</key>
        <string>/opt/cogneva/web</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
</dict>
</plist>
