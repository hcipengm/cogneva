#!/usr/bin/env bash
# 编译之前先问一句：这一轮的待办，都改完了吗？
#
# 默认是**全量编辑**：这一轮所有未完成的待办，一次改完，再编译一次。所以这个垫片在
# 脏树上做两件事：
#
#   1. 跑 `family.py --all-todos`：把「未完成待办的触点 ∪ 工作区改动」作为默认批次，
#      有缺口（待办点名了但还没改的文件、或者没写触点的待办）就**拒绝编译**，
#      并把缺口打出来——它给的不是禁令，是下一步该改什么。
#   2. 记一行账：时间、工作树、参数、HEAD、树指纹。推之前那道门用它判两件事——
#      「编辑晚于最后一次编译」与「一批编译了几次」。
#
# **要拆**：在编译前声明四条理由之一，例如
#     COGNEVA_BATCH_SPLIT="1 — cog-gateway 与 cog-storage 的验证面不同" cargo test -p cog-storage
# 声明会随这一笔进提交历史（推之前的门会再判一次真假），所以它不是免检牌。
#
# 干净树上不拦：没有待办在改，就没有「没改完」这回事。**没有绕过开关**：绕过一次，
# 「同批编辑」就退回成「我挑的那几条」，而这正是这一层存在的理由。
set -u

real_cargo="${REAL_CARGO:-$HOME/.cargo/bin/cargo}"
ledger="${COGNEVA_COMPILE_LEDGER:-$HOME/.local/state/cogneva/compile-ledger.tsv}"
# 这个垫片被装在 PATH 上（/usr/local/bin 或 ~/.local/bin），所以它**不能**从自己的
# 位置找 `family.py`——那份工具跟着仓库走，位置由当前工作树决定。
toplevel="$(git rev-parse --show-toplevel 2>/dev/null || true)"
family="${toplevel:+$toplevel/scripts/hooks/family.py}"

sub="${1:-}"
# 两类命令分开：**只读类型检查**（`check`）随时可以跑——它不产出可推送的
# 字节，不破坏「验过的字节＝要推的字节」，而它是把十分钟的编辑变成可确认的唯一手段。
# 把它也关在批次门后面，等于让一批跨天的待办把树冻在「无法确认能不能编译」里，
# 那不是严格，是把可验证性关掉了（2026-11-20 现场）。`clippy` 不放行：它在 CI 上跑，
# 一条 lint 的判词属于那一笔的 CI 结论，不属于本地这一拍。
case "$sub" in
  check) builds=0 ;;
  clippy|build|test|run|bench|doc|nextest|install|fix) builds=1 ;;
  *) builds=0 ;;
esac

dirty=0
if git rev-parse --git-dir >/dev/null 2>&1 && [ -n "$(git status --porcelain 2>/dev/null)" ]; then
  dirty=1
fi

# 判据是「这一轮开工以来改了什么」，不是「工作树干不干净」：每做完一小块就提交的人，
# 工作树永远是干净的，按脏树判等于把门整个跳过——而漏下的子集正是这样漏掉的。
# 没有开着一轮、或者事件流读不到：**判不了**，不是「没有缺口」。判不了就不许编译——
# 没有轮的时候 family 会退回「与 origin/main 的差」，那是整段历史，看起来毫无缺口。
if [ -f "$toplevel/scripts/hooks/round.py" ]; then
  if ! round_out=$(python3 "$toplevel/scripts/hooks/round.py" status 2>&1); then
    case "$round_out" in
      *"还剩"*) : ;;
      *)
        printf '%s\n' "$round_out" >&2
        cat >&2 <<'EOF'

cargo: 这一轮判不了，先别编译。

  要么没有开着一轮（`scripts/hooks/round.py open`），要么事件流读不到。
  「判不了」与「没有缺口」是两件事：退回「与 origin/main 的差」会把整段历史
  当成这一轮的改动，缺口一律看不见。
EOF
        exit 1
        ;;
    esac
  fi
fi

# 第 3 步：编译之前工作树必须是干净的——没提交的改动不会被推上去，编出来的字节与推的
# 不是同一份，门的「已验」就对不上。提交是独立的一步，它有自己的判据，不是顺手做的。
if [ "$builds" = "1" ] && [ "$dirty" = "1" ]; then
  cat >&2 <<'EOF'
cargo: 工作树不干净，先提交再编译。

  没提交的改动不会被推上去：脏树上编出来的字节与最终推的不是同一份，门的「已验」
  记账就对不上那一次推送。先把这一批的编辑提交完（提交多少笔都行），再编译一次。
EOF
  git status --porcelain >&2 || true
  exit 1
fi

if [ "$builds" = "1" ] && [ -f "$family" ] && [ -f "$toplevel/scripts/hooks/round.py" ]; then
  if [ -z "${COGNEVA_BATCH_SPLIT:-}" ]; then
    # 垫片问的是「这一遍编辑走完了没有」（`--editing`，按触点判），不是「做完没有」
    # （三格，推之前与终态门判）。两者分开之后，编译不再等三格填满——而三格也永远
    # 不会因为「文件改过」而被点亮。
    if ! python3 "$family" --root "$toplevel" --all-todos --editing; then
      cat >&2 <<'EOF'

cargo: 这一轮还有待办没改完，先别编译。

  上面每一条 TODO 都是「这一轮该改、但还没改」的地方：待办点名的触点、或者从仓库
  那几张配套表反查出来的缺口。默认的做法是把它们一次改完，再编译一次。

  如果这一轮确实要拆，就在编译前声明四条理由之一（会随提交进历史，推之前还要被判一次）：

      COGNEVA_BATCH_SPLIT="1 — <两侧边界>"   # 验证面不同
      COGNEVA_BATCH_SPLIT="2 — <会重叠的测试目标>"  # 失败不可归因
      COGNEVA_BATCH_SPLIT="3 — <哪一处不可逆>"      # 要滚动/迁移/动现场
      COGNEVA_BATCH_SPLIT="4 — <这一侧为什么读不完>" # 工作集超限

EOF
      exit 1
    fi
  else
    printf 'cargo: 本批按声明拆分：%s\n' "$COGNEVA_BATCH_SPLIT" >&2
  fi
fi

fingerprint() {
  {
    git rev-parse HEAD 2>/dev/null || echo "no-head"
    git status --porcelain=v2 2>/dev/null
    git diff HEAD 2>/dev/null
    git ls-files --others --exclude-standard 2>/dev/null
  } | sha256sum | cut -d' ' -f1
}

if [ "$ledger" != "/dev/null" ]; then
  {
    mkdir -p "$(dirname "$ledger")" 2>/dev/null || true
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$PWD" "$*" \
      "$(git rev-parse HEAD 2>/dev/null || echo no-head)" "$(fingerprint 2>/dev/null || echo no-tree)" \
      >>"$ledger"
  } 2>/dev/null || true
fi

exec "$real_cargo" "$@"
