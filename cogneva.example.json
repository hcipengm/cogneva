    "COGNEVA_MEMORY_MESSAGE_BROADCAST_CAPACITY": "system.memory_message_broadcast_capacity",
    "COGNEVA_OBSERVABILITY_EVENT_CHANNEL_CAPACITY": "system.observability_event_channel_capacity",
    "COGNEVA_WEBSOCKET_EVENT_CACHE_CAPACITY": "system.websocket_event_cache_capacity",
    "COGNEVA_ANTHROPIC_DEFAULT_MAX_TOKENS": "system.anthropic_default_max_tokens",
    "COGNEVA_WEBSOCKET_TIMEOUT_SECS": "gateway.websocket_timeout_secs",
    "COGNEVA_WEBSOCKET_INACTIVITY_TIMEOUT_SECS": "gateway.websocket_inactivity_timeout_secs",
    "COGNEVA_WEBSOCKET_TICK_SECS": "gateway.websocket_tick_secs",
    "COGNEVA_NOTIFICATION_LIMIT": "gateway.notification_limit",
    "COGNEVA_SANDBOX_TASK_TIMEOUT_SECS": "gateway.sandbox_task_timeout_secs",
    "COGNEVA_REQUEST_TIMEOUT_SECS": "gateway.request_timeout_secs",
    "COGNEVA_NOTIFICATION_WEBHOOK_URL": "gateway.notification_webhook_url",
    "COGNEVA_STREAM_CAPACITY": "tuning.stream_capacity",
    "COGNEVA_HIGH_WATERMARK": "tuning.high_watermark",
    "COGNEVA_LOW_WATERMARK": "tuning.low_watermark",
    "COGNEVA_MAX_SUMMARIES": "tuning.max_summaries",
    "COGNEVA_STRICT_PERSISTENCE": "system.strict_persistence",
    "COGNEVA_VECTOR_BACKEND_REQUIRED": "system.vector_backend_required"
  },
  "app": {
    "name": "cogneva",
    "version": "0.1.0",
    "log_level": "info",
    "data_dir": "/var/lib/cogneva-data",
    "config_dir": "/etc/cogneva",
    "app_dir": "/opt/cogneva"
  },
  "llm_routing": {
    "_comment": "LLM 平等：业务侧只配置安全网关透传一个后端，不出现任何厂商名。api_key/model 是写死的非敏感占位（后端构建要求非空）；真实上游池（api_style/base_url/model/api_key，可多个按序故障转移）由 WebUI 向导 / llm-config API 写入网关侧的 llm-upstreams secret。api_style 声明网关透传面兼容的 API 风格：openai。",
    "strategy": "failover",
    "retry_on_429": true,
    "retry_on_402": true,
    "max_failover_attempts": 3,
    "backends": [
      {
        "provider": "gateway",
        "api_key": "via-security-gateway",
        "base_url": "http://cogneva-security-gateway:8081/v1",
        "model": "via-security-gateway",
        "api_style": "openai",
        "weight": 1,
        "enabled": true
      }
    ]
  },
  "providers": {
    "db": {
      "provider": "mysql",
      "enabled": false,
      "options": {
        "host": "mysql.cogneva.svc.cluster.local",
        "port": 3306,
        "database": "cogneva",
        "user": "cog_user",
        "password": "${DB_PASSWORD}"
      }
    },
    "pg": {
      "provider": "postgres",
      "enabled": true,
      "options": {
        "connection": "postgres://cog_user:${PG_PASSWORD}@postgres.cogneva.svc.cluster.local:5432/cogneva",
        "host": "postgres.cogneva.svc.cluster.local",
        "port": 5432,
        "database": "cogneva",
        "user": "cog_user",
        "password": "${PG_PASSWORD}"
      }
    },
    "vector": {
      "provider": "qdrant",
      "enabled": true,
      "options": {
        "url": "http://qdrant.cogneva.svc.cluster.local:6334",
        "collection": "summaries",
        "api_key": null
      }
    },
    "media": {
      "provider": "local-sfu",
      "enabled": false,
      "options": {}
    },
    "storage": {
      "provider": "local-fs",
      "enabled": true,
      "options": {
        "base_path": "/var/lib/cogneva-data/storage"
      }
    },
    "wiki": {
      "provider": "meilisearch",
      "enabled": true,
      "options": {
        "host": "http://meilisearch.cogneva.svc.cluster.local:7700",
        "api_key": null,
        "index": "wiki"
      }
    }
  },
  "dag_executor": {
    "redis_url": "redis://redis-0.redis.cogneva.svc.cluster.local:6379",
    "nats": {
      "urls": [],
      "auth": {
        "username": null,
        "password": null,
        "token": null
      },
      "tls": {
        "enabled": false,
        "ca_cert_path": null,
        "client_cert_path": null,
        "client_key_path": null,
        "insecure_skip_verify": false
      }
    },
    "workspace_id": "default",
    "consumer_group": "cogneva",
    "max_retries": 3,
    "retry_delay_ms": 1000,
    "ready_task_poll_interval_secs": 5,
    "batch_persistence_enabled": false,
    "batch_persistence_max_changes": 10,
    "batch_persistence_interval_secs": 5,
    "archive_enabled": true,
    "archive_after_secs": 3600,
    "archive_poll_interval_secs": 300,
    "_comment_task_lease_secs": "任务租约时长（秒）：执行者拿到任务时写下「我持有它到此刻」，之后按这一时长的三分之一心跳续期。持有者的进程被换掉后心跳就停，租约到期即判为可回收，任务回到重试而不是卡在 Running 到不了任何终态。取值要大于 system.timeout_checker_interval_secs，否则一次扫描还没到就已被判过期；也不宜太短，比单次任务正常时长还短会误伤正在跑的活。",
    "task_lease_secs": 120
  },
  "gateway": {
    "http_port": 8080,
    "ws_port": 8081,
    "metrics_port": 9090,
    "cors_origins": [
      "*"
    ],
    "websocket_timeout_secs": 30,
    "websocket_inactivity_timeout_secs": 90,
    "websocket_tick_secs": 5,
    "notification_limit": 50,
    "sandbox_task_timeout_secs": 30,
    "request_timeout_secs": 30,
    "notification_webhook_url": null
  },
  "metrics": {
    "enabled": true,
    "endpoint": "/metrics",
    "interval_secs": 15,
    "_comment_sample_retention_secs": "cog_metrics_samples 是只追加的观测样本日志，这条是它的保留窗（秒），0=永不清理。读侧全是短窗——抓取读直方图 300 秒、仪表 3600 秒，admin 接口默认 60 秒，而计数器本来就不读这张表（走 cog_metric_counter_totals），所以超出最宽读窗的行任何代码路径都取不回来，只占磁盘。默认一整天：比最宽读窗大一个数量级以上，又与摄取对账的回看窗同长，读指标窗和读摄取窗看的是同一段。",
    "sample_retention_secs": 86400,
    "_comment_sample_retention_sweep_interval_secs": "清理扫描间隔（秒）。每轮扫描同时重报这张表的大小，所以它必须显著小于抓取侧的仪表回看窗，",
    "sample_retention_sweep_interval_secs": 600
  },
  "raw_logger": {
    "_comment": "enabled=false 是给手工安装的安全默认；随 chart 发布的部署把它打开，值写在 chart 的 files/cogneva.json 与本文件同名段落里。base_dir 同时是 trace 存储的根（<base_dir>/traces），改它等于换 trace 落点。",
    "_comment_flush_interval_secs": "落盘由两个条件触发：缓冲满 max_buffer_size 条，或距上次落盘满 flush_interval_secs 秒。低流量 stream 可以长时间够不到条数阈值，那期间写下的记录全在进程内存里，进程一挂即失——所以时间上界不能省。置 0 只留条数阈值。",
    "enabled": false,
    "base_dir": "/var/lib/cogneva-data/raw-logs",
    "max_buffer_size": 1000,
    "format": "proto",
    "zstd_level": null,
    "flush_interval_secs": 1
  },
  "memory": {
    "_comment": "Memory backend — enabled by default for self-evolution persistence.",
    "enabled": true,
    "backend_type": "memory",
    "base_dir": "/var/lib/cogneva-data/memory",
    "embedding_dimension": 128,
    "auto_ingest": true
  },
  "tier_migrator": {
    "_comment": "跟 raw_logger.enabled 一起翻：日志没开时无物可迁。随 chart 发布的部署把两者都打开，值写在 chart 的 files/cogneva.json 与本文件同名段落里。",
    "_comment_owner": "hot/warm/cold 迁移必须只有一个属主：raw_log_index 按 (stream, log_date, format) 唯一，冷层对象键又不带进程身份，一键多写就会让一个部署的记录覆盖另一个部署的索引行（对象存储同键亦然）。属主是主应用 Pod，进化 Pod 在 deploy 侧的 COGNEVA_TIER_MIGRATOR_ENABLED=false 关掉它。",
    "enabled": false,
    "hot_duration_secs": 86400,
    "warm_duration_secs": 604800,
    "warm_compression_level": 3,
    "cold_compression_level": 9,
    "scan_interval_secs": 3600,
    "cold_key_prefix": "raw"
  },
  "supervisor": {
    "health_interval_secs": 10,
    "quota_interval_secs": 60,
    "rebalance_interval_secs": 300,
    "event_window_secs": 30,
    "broadcast_capacity": 256,
    "quota_threshold": 1000,
    "behavior_history_max": 20,
    "heartbeat_history_max": 1000,
    "alert_history_max": 10000,
    "control_plane_interval_secs": 30,
    "control_plane_url": null,
    "health_checker": {
      "suspect_after_secs": 15,
      "dead_after_secs": 60,
      "stuck_after_secs": 600
    },
    "task_rebalancer": {
      "max_tasks_per_agent": 4,
      "max_assignments_per_pass": 32
    }
  },
  "hook_engine": {
    "dedup_window_secs": 1,
    "hook_timeout_secs": 30,
    "default_rate_limit": {
      "burst": 100,
      "per_second": 100
    }
  },
  "boundary": {
    "rules": [
      {
        "name": "TokenBudget",
        "rule_type": "hard",
        "threshold": 100000,
        "description": "单个任务的 estimated_tokens 不得超过阈值",
        "enabled": true
      },
      {
        "name": "OutputQuality",
        "rule_type": "soft",
        "threshold": null,
        "description": "生成输出必须满足以下质量标准：1) 代码必须包含单元测试 2) 文档必须完整 3) 无已知安全漏洞",
        "enabled": true
      }
    ]
  },
  "agent_loop": {
    "agent_id": "agent-001",
    "role": "planner",
    "max_iterations": 10,
    "eval_max_iterations": 5,
    "context_window_size": 64000,
    "skill_cache_ttl_secs": 30
  },
  "observability": {
    "infra_watch": {
      "_comment": "基础设施告警→持久化→自发现。规则即部署策略：阈值改这里不用重建镜像。series 消失或条件不再成立会自动 resolve；规则查询失败不会误 resolve。",
      "enabled": true,
      "prometheus_url": "http://cog-observability-prometheus.monitoring:9090",
      "poll_interval_secs": 60,
      "eval_failure_alert_after": 3,
      "rules": [
        {
          "name": "node_disk_usage_high",
          "promql": "100 - 100 * node_filesystem_avail_bytes{mountpoint=\"/\", fstype=~\"ext4|xfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype=~\"ext4|xfs|overlay\"}",
          "condition": {
            "greater_than": 75.0
          },
          "severity": "warning",
          "summary": "node root filesystem usage above 75% (current {value}%)"
        },
        {
          "name": "node_disk_usage_critical",
          "promql": "100 - 100 * node_filesystem_avail_bytes{mountpoint=\"/\", fstype=~\"ext4|xfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype=~\"ext4|xfs|overlay\"}",
          "condition": {
            "greater_than": 85.0
          },
          "severity": "critical",
          "summary": "node root filesystem usage above 85% (current {value}%); kubelet eviction starts soon"
        },
        {
          "name": "node_disk_pressure",
          "promql": "kube_node_status_condition{condition=\"DiskPressure\", status=\"true\"}",
          "condition": {
            "greater_than": 0.0
          },
          "severity": "critical",
          "summary": "kubelet reports DiskPressure; pods are being evicted"
        },
        {
          "name": "node_memory_pressure",
          "promql": "kube_node_status_condition{condition=\"MemoryPressure\", status=\"true\"}",
          "condition": {
            "greater_than": 0.0
          },
          "severity": "warning",
          "summary": "kubelet reports MemoryPressure"
        },
        {
          "name": "pod_restarting_fast",
          "promql": "increase(kube_pod_container_status_restarts_total{namespace=\"cogneva\"}[15m])",
          "condition": {
            "greater_than": 5.0
          },
          "severity": "warning",
          "summary": "cogneva pod restarting more than 5 times in 15m ({value})"
        },
        {
          "name": "pod_oom_killed",
          "promql": "kube_pod_container_status_last_terminated_reason{namespace=\"cogneva\", reason=\"OOMKilled\"}",
          "condition": {
            "greater_than": 0.0
          },
          "severity": "critical",
          "summary": "cogneva workload container last exit was OOMKilled; memory footprint exceeds its limit"
        },
        {
          "name": "ralph_loop_terminations_high",
          "promql": "increase(ralph_terminations_total[30m])",
          "condition": {
            "greater_than": 20.0
          },
          "severity": "warning",
          "summary": "Ralph loops stopped {value} times in the last 30m without passing their goal; the evolution chain is burning budget instead of converging (the reason label distinguishes budget_exhausted from stagnated)"
        },
        {
          "name": "declared_failure_class_unrecorded",
          "promql": "collab_classification_unreachable",
          "condition": {
            "greater_than": 0.0
          },
          "severity": "warning",
          "summary": "A declared failure class is being announced while its series stays at zero, so the classification is being lost between the producer and the termination record; the class label names which one"
        },
        {
          "name": "self_evolution_yields_no_change",
          "promql": "increase(self_evolution_change_yield_total{outcome=~\"no_artifacts|submit_failed\"}[6h])",
          "condition": {
            "greater_than": 2.0
          },
          "severity": "warning",
          "summary": "Self-evolution chains reported success {value} time(s) in the last 6h while producing no change to land (no_artifacts: the pipeline yielded no valid diff; submit_failed: every sink rejected it); the landing channel stays empty and the loop silently stops evolving"
        },
        {
          "name": "cogneva_workload_metrics_unscraped",
          "promql": "avg_over_time((count(kube_pod_container_info{namespace=\"cogneva\", image=~\".*cogneva.*\"} and on(pod) kube_pod_status_phase{namespace=\"cogneva\", phase=\"Running\"} == 1 unless on(pod) kube_pod_owner{namespace=\"cogneva\", owner_kind=\"Job\"}) - count(up{namespace=\"cogneva\"}))[15m:1m])",
          "condition": {
            "greater_than": 0.5
          },
          "severity": "warning",
          "summary": "On average {value} running cogneva workload(s) had no Prometheus scrape target over the last 15m: their /metrics is produced but never collected, so every alert they would raise is invisible (usual causes: the workload has no Service, its Service port is not named http or metrics, or a NetworkPolicy blocks the monitoring namespace)"
        }
      ]
    },
    "trace_collector": {
      "_comment": "trace 事件按 agent 在内存缓冲直到 AgentEnd 落盘；长任务无界累积会 OOM。超过预算即分块落盘（part 后缀），预算按部署内存定。",
      "buffer_max_bytes": 16777216
    }
  },
  "self_review": {
    "_comment": "PGE actor self-review quality gate. enabled=true 时 Planner/Generator/Evaluator/Moderator/Merger 的输出会经过 SelfReviewLoop 审查并用修订结果替换原始输出。",
    "enabled": true,
    "max_iterations": 2,
    "quality_threshold": 0.8,
    "spec": null,
    "best_practices": []
  },
  "pge": {
    "_comment": "PGE actor 输出契约。schemas 按 actor 名（planner/generator/evaluator/moderator/merger）配置 JSON Schema；配置后 schema 会注入 prompt 上下文并对 LLM 原始输出做校验，校验失败仅告警并回退宽松解析，不会中断流水线。默认为空 = 使用内置契约。",
    "_comment_local_repair_max": "局部修复预算：Evaluator 判失败后保持当前 Plan 不变、把 feedback 回传给 Generator 再生成的次数，耗尽才做全局重置（重跑 Planner）。0 = 关闭这条路径，于是每次失败都从新 Plan 重来。写在这里是因为 schemas 一旦配置就很难注意到这条键缺了，而缺了的读法是 0。",
    "schemas": {},
    "local_repair_max": 2
  },
  "lifecycle": {
    "heartbeat_interval_secs": 5,
    "suspect_threshold": 2,
    "dead_threshold": 5,
    "registration_ttl_secs": 60,
    "cleanup_interval_secs": 300
  },
  "tuning": {
    "stream_capacity": 256,
    "high_watermark": 1000,
    "low_watermark": 100,
    "max_summaries": 10
  },
  "agent_pool": {
    "enabled": true,
    "worker_count": 3,
    "worker_role": "planner"
  },
  "self_evolution": {
    "_comment": "Self-evolution auto-deploy pipeline. enabled/auto_apply/auto_deploy all true means fully autonomous: LLM generates code changes, tests, commits, builds, and switches binary without human intervention. Sandbox boundary check: real apply/deploy requires a detected isolated environment (K8s Pod/container/COGNEVA_SANDBOX), sandbox_mode=true, or force_autonomous=true; otherwise the pipeline downgrades to dry-run.",
    "enabled": true,
    "auto_apply": true,
    "auto_deploy": true,
    "sandbox_mode": true,
    "force_autonomous": false,
    "manual_approve": false,
    "change_dir": "./evolution-changes",
    "binary_dir": "/opt/cogneva/bin",
    "backup_dir": "/opt/cogneva/bin/backups",
    "switch_mode": "self_exec",
    "health_check_grace_period_secs": 10,
    "health_check_interval_secs": 5,
    "health_check_max_retries": 6,
    "test_timeout_secs": 600,
    "build_timeout_secs": 1800,
    "poll_interval_secs": 60,
    "notify_on_success": true,
    "notify_on_failure": true
  },
  "multi_backend_consumer": {
    "enabled": true,
    "channel": "cogneva-events",
    "group": "cogneva-consumer",
    "retry_interval_secs": 5
  },
  "github_integration": {
    "_comment": "GitHub integration for self-evolution. Tokens are resolved from environment variables and never enter the sandbox.",
    "enabled": false,
    "_comment_discovery_enabled": "Whether THIS process runs the discovery loops. One binary serves several deployments and each builds its own plugin table, so when two processes are up they otherwise scan the same upstream items and ask the same clarification twice (intent guards are per-pod files). Leave true unless this deployment is a secondary process of an installation whose main app already discovers.",
    "discovery_enabled": true,
    "discovery_mode": "polling",
    "repo": "owner/cogneva",
    "base_branch": "main",
    "accounts": [
      {
        "kind": "bot",
        "username": "cogneva-bot",
        "name": "Cogneva Bot",
        "email": "bot@cogneva.ai",
        "token_env": "COGNEVA_GITHUB_BOT_TOKEN",
        "token": null,
        "app_installation_id": null
      },
      {
        "kind": "human",
        "username": "human-operator",
        "name": "Human Operator",
        "email": "human@example.com",
        "token_env": "COGNEVA_GITHUB_HUMAN_TOKEN",
        "token": null
      }
    ],
    "poll_interval_secs": 300,
    "max_issues_per_scan": 50,
    "webhook": {
      "_comment": "Webhook event entry, used when discovery_mode=events/both. Secret resolved from env, never stored here.",
      "port": 9090,
      "secret_env": "COGNEVA_GITHUB_WEBHOOK_SECRET",
      "path": "/webhooks/github"
    },
    "git_workdir": "",
    "_comment_git_workdir": "Local git working copy the landing channel commits and pushes from. Empty derives one under the data dir (COGNEVA_DATA_DIR/git-workdir); whether changes actually go upstream is the contribution policy's decision, not a path setting. Git transport goes through the security gateway HTTPS proxy (COGNEVA_GIT_PROXY_BASE, set in deployment env); no token or deploy key lives in this pod.",
    "api_base": null,
    "_comment_api_base": "GitHub API base override. Point it at the security gateway passthrough endpoint (COGNEVA_GITHUB_API_BASE, e.g. http://cogneva-security-gateway:8081/github) so this process holds no platform token; leave null to talk to api.github.com directly with the token_env/inline token.",
    "auto_submit_fixes": true,
    "landing_policy": {
      "_comment": "Bounds what a landed change may touch, and what happens when CI on a landed commit fails. Quality is settled by the sandbox (pre-check, apply, test, release build) before the channel is called, so there is no score gate here; whether changes go upstream at all is the contribution policy's decision (auto/ask/local), so there is no on/off switch either.",
      "max_changed_lines": 200,
      "forbidden_paths": [
        ".github/workflows",
        "deploy/",
        "secrets/",
        "*.lock"
      ],
      "revert_on_ci_failure": true,
      "redrive_on_ci_failure": true,
      "ci_watch_timeout_secs": 1800,
      "ci_poll_interval_secs": 60,
      "max_land_attempts": 3
    },
    "human_required_labels": [
      "security",
      "breaking-change"
    ],
    "forbidden_labels": [
      "wontfix",
      "manual-only"
    ],
    "allowed_issue_states": [
      "open"
    ],
    "conversation": {
