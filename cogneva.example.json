    "COGNEVA_SELF_EVOLUTION_TEST_TIMEOUT_SECS": "self_evolution.test_timeout_secs",
    "COGNEVA_SELF_EVOLUTION_BUILD_TIMEOUT_SECS": "self_evolution.build_timeout_secs",
    "COGNEVA_TOOL_TIMEOUT_SECS": "system.tool_timeout_secs",
    "COGNEVA_SHELL_TIMEOUT_SECS": "system.shell_timeout_secs",
    "COGNEVA_SKILL_HOT_RELOAD_INTERVAL_SECS": "system.skill_hot_reload_interval_secs",
    "COGNEVA_GRPC_RECONNECT_INTERVAL_SECS": "system.grpc_reconnect_interval_secs",
    "COGNEVA_PROBE_TIMEOUT_SECS": "system.probe_timeout_secs",
    "COGNEVA_HTTP_TIMEOUT_SECS": "system.http_timeout_secs",
    "COGNEVA_PATTERN_DB_MAX_SIZE": "system.pattern_db_max_size",
    "COGNEVA_PATTERN_MAX_AGE_DAYS": "system.pattern_max_age_days",
    "COGNEVA_PG_MAX_CONNECTIONS": "system.pg_max_connections",
    "COGNEVA_PG_MIN_CONNECTIONS": "system.pg_min_connections",
