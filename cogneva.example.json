    "COGNEVA_SELF_EVOLUTION_SANDBOX_MODE": "self_evolution.sandbox_mode",
    "COGNEVA_SELF_EVOLUTION_FORCE_AUTONOMOUS": "self_evolution.force_autonomous",
    "COGNEVA_SELF_EVOLUTION_SWITCH_MODE": "self_evolution.switch_mode",
    "COGNEVA_SELF_EVOLUTION_CHANGE_DIR": "self_evolution.change_dir",
    "COGNEVA_SELF_EVOLUTION_BINARY_DIR": "self_evolution.binary_dir",
